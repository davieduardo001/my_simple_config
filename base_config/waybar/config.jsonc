{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 4,

    "modules-left": ["custom/workspaces", "hyprland/window"],
    "modules-center": ["mpris", "clock"],
    "modules-right": ["tray", "network", "bluetooth", "pulseaudio", "battery", "custom/notifications"],

    "custom/workspaces": {
        "exec": "~/.config/waybar/scripts/workspace-icons.sh",
        "return-type": "",
        "escape": false,
        "on-click": "hyprctl dispatch workspace e+1"
    },

    "hyprland/window": {
        "max-length": 40,
        "separate-outputs": true
    },

    "mpris": {
        "format": "<span foreground='#957fb8'>●</span>  {artist} - {title}",
        "format-paused": "<span foreground='#957fb8'>●</span>  {artist} - {title}",
        "format-stopped": "",
        "max-length": 36,
        "dynamic-order": ["artist", "title"],
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "tooltip-format": "{player} · {status}"
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a %d %b · %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    "network": {
        "format-wifi": "󰤨  {essid}",
        "format-ethernet": "󰈀  {ipaddr}",
        "format-disconnected": "󰖪  off",
        "tooltip-format": "{ifname} · {ipaddr}",
        "max-length": 24,
        "on-click": "~/.config/hypr/scripts/wifi-menu.sh"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱 {num_connections}",
        "format-disabled": "󰂲",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "battery": {
        "states": {
            "warning": 25,
            "critical": 10
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },

    "custom/notifications": {
        "format": "󰂚",
        "tooltip": false,
        "on-click": "swaync-client -t -sw"
    }
}
